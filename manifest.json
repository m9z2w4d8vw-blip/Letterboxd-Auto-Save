{
  "manifest_version": 3,
  "name": "Letterboxd Draft Saver",
  "version": "1.0.0",
  "description": "Saves your Letterboxd review as you type, so a crash, a closed tab, or a stray click can't take it with them.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://*.letterboxd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*",
        "https://*.letterboxd.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Letterboxd drafts",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
